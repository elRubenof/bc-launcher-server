{
  "openapi": "3.1.0",
  "info": {
    "title": "BC Launcher Server",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "DiscoveryDocument": {
        "type": "object",
        "properties": {
          "discoveryVersion": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "logoUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "iconUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "links": {
            "type": "object",
            "properties": {
              "discord": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "web": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            },
            "required": [
              "discord",
              "web"
            ]
          },
          "serverVersion": {
            "type": "string"
          },
          "apiVersions": {
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "minLauncherVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auth": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "mojang-session"
                ]
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "discoveryVersion",
          "visibility",
          "name",
          "description",
          "logoUrl",
          "iconUrl",
          "links",
          "serverVersion",
          "apiVersions",
          "minLauncherVersion",
          "capabilities",
          "auth"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/.well-known/bc-launcher": {
      "get": {
        "summary": "Organization discovery document",
        "tags": [
          "Discovery"
        ],
        "responses": {
          "200": {
            "description": "Public identity and capabilities of this organization's server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryDocument"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
