{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bc-launcher-server",
  "main": "apps/api/src/entry/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Always serve on <name>.<subdomain>.workers.dev (the address to open after Deploy to Cloudflare),
  // whatever the dashboard shows. Preview URLs would expose every uploaded version publicly: off.
  "workers_dev": true,
  "preview_urls": false,
  // The panel and public page (apps/web, built with `pnpm build:web`). Unknown paths get
  // index.html for the client-side router; API paths always reach the Worker.
  "assets": {
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bc-launcher-server",
      "migrations_dir": "packages/db/migrations"
    }
  ],
  // Hourly orphan blob cleanup (the `scheduled` handler in apps/api/src/entry/worker.ts).
  "triggers": { "crons": ["17 * * * *"] },
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "bc-launcher-server-blobs"
    }
  ]
  // JWT_SECRET is optional: without it the server generates one and keeps it in D1; set it with
  // `wrangler secret put` (or `.dev.vars` locally) to manage it yourself. PUBLIC_URL is optional
  // too: without it, the public URL is the origin each request came in on (workers.dev or a
  // custom domain); set it as a var to force one.
  // MOJANG_SESSION_URL is optional: Mojang blocks Workers, so without it player names aren't
  // verified (README → "Player identity"). Set it to a proxy of Mojang's session server, e.g.
  // "vars": { "MOJANG_SESSION_URL": "https://proxy.example.com/session/minecraft" }
}
