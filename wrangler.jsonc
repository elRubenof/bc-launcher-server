{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bc-launcher-server",
  "main": "apps/api/src/entry/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // The panel and public page (apps/web, built with `pnpm build:web`). Unknown paths get
  // index.html for the client-side router; API paths always reach the Worker.
  "assets": {
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bc-launcher-server",
      "migrations_dir": "packages/db/migrations"
    }
  ],
  // Hourly orphan blob cleanup (the `scheduled` handler in apps/api/src/entry/worker.ts).
  "triggers": { "crons": ["17 * * * *"] },
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "bc-launcher-server-blobs"
    }
  ],
  // PUBLIC_URL is the deployment's public origin. SESSION_SECRET and JWT_SECRET are secrets:
  // `wrangler secret put` in production, `.dev.vars` locally.
  "vars": {
    "PUBLIC_URL": "http://localhost:8787"
  }
}
